# Copy to apps/worker/.env. The worker uses the service role: run it only on trusted infrastructure.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional
WORKER_ID=
WORKER_POLL_MS=5000
# Notification emails (Settings › Notifications). Without SMTP_URL they wait in the outbox and expire after two days.
# smtp://user:password@host:587 (STARTTLS) or smtps://user:password@host:465; locally Mailpit: smtp://127.0.0.1:54325
SMTP_URL=
EMAIL_FROM=PeopleCore <no-reply@example.test>
# The app's address, for links in emails (https://hr.example.com)
APP_URL=
# Phone push notifications (Firebase Cloud Messaging): the Firebase service account's JSON (Project settings ›
# Service accounts › Generate new private key), on one line or base64-encoded. Without it pushes wait and expire after a day.
FCM_SERVICE_ACCOUNT=
