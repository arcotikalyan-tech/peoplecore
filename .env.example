# Copy to apps/web/.env.local. Never commit real values.
# Use the PeopleCore Supabase project only (never the Vibe Upp one).
# Values: Supabase Dashboard → Project Settings → API Keys.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…). Safe in browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). SERVER ONLY: bypasses RLS. Used by src/server/admin.ts and the seed script.
SUPABASE_SECRET_KEY=
