# Copy to apps/web/.env.local. Never commit real values.
# Use the PeopleCore Supabase project only (never the Vibe Upp one).
# Values: Supabase Dashboard → Project Settings → API Keys.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…). Safe in browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). SERVER ONLY: bypasses RLS. Used by src/server/admin.ts and the seed script.
SUPABASE_SECRET_KEY=

# AI assistants (optional; without a key they say "AI isn't set up"). SERVER ONLY: read in src/server/ai.ts.
# See docs/runbooks/ai.md. Use a no-training / zero-retention arrangement with the provider.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Development and browser tests without a model: fixed answers built from the retrieved sources (refused in production).
# AI_PROVIDER=mock

# Email (docs/runbooks/email.md). SERVER ONLY. The app sends account emails for Supabase's send-email hook and platform
# admins' test emails; the worker reads the same three for notifications. Locally: the Supabase test inbox, and the
# hook secret from supabase/config.toml ([auth.hook.send_email]).
# SMTP_URL=smtp://127.0.0.1:54325
# EMAIL_FROM=PeopleCore <no-reply@peoplecore.example.test>
# APP_URL=http://localhost:3000
# SEND_EMAIL_HOOK_SECRET=
